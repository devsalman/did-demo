<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Credential - Identity Lab</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg-primary: #080808;
      --bg-secondary: #0f0f0f;
      --text-primary: #e8e8e2;
      --text-secondary: #a8a8a0;
      --accent: #00ff88;
      --accent-dim: #00cc6e;
      --border: #1a1a1a;
      --error: #ff4444;
      --success: #00ff88;
      --json-key: #7ec8e3;
      --json-string: #c3e88d;
      --json-number: #f78c6c;
      --json-bool: #ff5370;
      --json-bracket: #a8a8a0;
      --jwt-header: #f78c6c;
      --jwt-payload: #c3e88d;
      --jwt-sig: #7ec8e3;
    }

    body {
      background-color: var(--bg-primary);
      color: var(--text-primary);
      font-family: 'JetBrains Mono', monospace;
      line-height: 1.6;
      min-height: 100vh;
      padding: 40px 20px;
    }

    .container { max-width: 900px; margin: 0 auto; }

    .header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 30px;
      margin-bottom: 40px;
    }

    .header h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 32px;
      font-weight: 600;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 8px;
    }

    .header p {
      color: var(--text-secondary);
      font-size: 14px;
    }

    .header-actions {
      display: flex;
      gap: 10px;
      margin-top: 20px;
    }

    .section {
      border: 1px solid var(--border);
      padding: 20px;
      margin-bottom: 20px;
      background: var(--bg-secondary);
    }

    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-secondary);
      margin-bottom: 15px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
    }

    .section-title .badge {
      float: right;
      font-size: 10px;
      padding: 3px 8px;
      border: 1px solid var(--accent);
      color: var(--accent);
    }

    .code-block {
      background: #000;
      border: 1px solid var(--border);
      padding: 20px;
      font-size: 12px;
      line-height: 1.8;
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-all;
      position: relative;
    }

    .code-block .copy-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 4px 10px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text-secondary);
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: all 0.2s ease;
    }

    .code-block .copy-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .code-block .copy-btn.copied {
      border-color: var(--success);
      color: var(--success);
    }

    .jwt-part {
      display: block;
      padding: 4px 0;
      word-break: break-all;
    }

    .jwt-part.header { color: var(--jwt-header); }
    .jwt-part.payload { color: var(--jwt-payload); }
    .jwt-part.sig { color: var(--jwt-sig); }

    .json-key { color: var(--json-key); }
    .json-string { color: var(--json-string); }
    .json-number { color: var(--json-number); }
    .json-bool { color: var(--json-bool); }
    .json-bracket { color: var(--json-bracket); }

    .button {
      padding: 10px 20px;
      border: 1px solid var(--accent);
      background: transparent;
      color: var(--accent);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .button:hover {
      background: var(--accent);
      color: var(--bg-primary);
    }

    .button.secondary {
      border-color: var(--text-secondary);
      color: var(--text-secondary);
    }

    .button.secondary:hover {
      border-color: var(--text-primary);
      color: var(--text-primary);
      background: transparent;
    }

    .error {
      border: 1px solid var(--error);
      padding: 15px;
      background: rgba(255, 68, 68, 0.05);
      color: var(--error);
      margin-bottom: 20px;
    }

    .loading { text-align: center; padding: 20px; color: var(--text-secondary); }

    .tab-bar {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--border);
      margin-bottom: 20px;
    }

    .tab {
      padding: 10px 20px;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: all 0.2s ease;
    }

    .tab:hover { color: var(--text-primary); }

    .tab.active {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .info-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      font-size: 13px;
      border-bottom: 1px solid var(--border);
    }

    .info-row:last-child { border-bottom: none; }

    .label { color: var(--text-secondary); }

    .value {
      color: var(--accent);
      font-weight: 500;
      word-break: break-all;
      text-align: right;
      max-width: 60%;
    }

    @media (max-width: 600px) {
      .header h1 { font-size: 22px; }
      .code-block { font-size: 11px; padding: 15px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Verifiable Credential</h1>
      <p>Full credential content from your wallet</p>
      <div class="header-actions">
        <button class="button" onclick="goToDashboard()">Back to Dashboard</button>
        <button class="button secondary" onclick="logout()">Logout</button>
      </div>
    </div>

    <div id="content">
      <div class="loading">Loading credential...</div>
    </div>
  </div>

  <script>
    const sessionToken = new URLSearchParams(window.location.search).get('session');
    let credentialData = null;
    let currentTab = 'claims';

    document.addEventListener('DOMContentLoaded', async () => {
      if (!sessionToken) {
        showError('No session token provided');
        return;
      }

      try {
        const response = await fetch(`/api/auth/credential?token=${sessionToken}`);
        if (!response.ok) throw new Error('Failed to load credential');

        credentialData = await response.json();
        renderCredential(credentialData);
      } catch (error) {
        showError(`Error: ${error.message}`);
      }
    });

    function renderCredential(data) {
      const cred = data.credential;
      if (!cred) {
        showError('No credential data available');
        return;
      }

      const html = `
        <div class="section">
          <div class="section-title">Verified Claims</div>
          <div id="claimsTab">
            ${renderClaimsTable(cred.credentialSubject || {})}
          </div>
        </div>

        <div>
          <div class="tab-bar">
            <button class="tab active" onclick="switchTab('claims')">Claims</button>
            <button class="tab" onclick="switchTab('full')">Full JSON</button>
            <button class="tab" onclick="switchTab('jwt')">JWT</button>
          </div>

          <div id="tab-claims" class="tab-content active">
            <div class="section">
              <div class="section-title">Credential Subject Claims</div>
              ${renderClaimsTable(cred.credentialSubject || {})}
            </div>
            <div class="section">
              <div class="section-title">Issuer Info</div>
              <div class="info-row">
                <span class="label">Issuer DID:</span>
                <span class="value">${cred.issuer || 'N/A'}</span>
              </div>
              <div class="info-row">
                <span class="label">Issuance Date:</span>
                <span class="value">${cred.issuanceDate ? new Date(cred.issuanceDate).toLocaleString() : 'N/A'}</span>
              </div>
              <div class="info-row">
                <span class="label">Credential ID:</span>
                <span class="value" style="font-size: 10px;">${cred.id || 'N/A'}</span>
              </div>
              <div class="info-row">
                <span class="label">Type:</span>
                <span class="value">${Array.isArray(cred.type) ? cred.type.join(', ') : cred.type || 'N/A'}</span>
              </div>
            </div>
          </div>

          <div id="tab-full" class="tab-content">
            <div class="section">
              <div class="section-title">Full Credential JSON</div>
              <div class="code-block">
                <button class="copy-btn" onclick="copyContent(this, 'fullJson')">Copy</button>
                <div id="fullJson">${syntaxHighlight(cred)}</div>
              </div>
            </div>
          </div>

          <div id="tab-jwt" class="tab-content">
            <div class="section">
              <div class="section-title">JWT Token</div>
              <div class="code-block">
                <button class="copy-btn" onclick="copyContent(this, 'jwtToken')">Copy</button>
                <div id="jwtToken">${renderJwt(data.vpToken)}</div>
              </div>
            </div>
            <div class="section">
              <div class="section-title">JWT Decoded</div>
              <div class="code-block">
                <button class="copy-btn" onclick="copyContent(this, 'jwtDecoded')">Copy</button>
                <div id="jwtDecoded">${renderJwtDecoded(data.vpToken)}</div>
              </div>
            </div>
          </div>
        </div>
      `;

      document.getElementById('content').innerHTML = html;
    }

    function renderClaimsTable(subject) {
      if (!subject || Object.keys(subject).length === 0) {
        return '<div class="error">No claims found</div>';
      }

      let rows = '';
      for (const [key, value] of Object.entries(subject)) {
        const label = key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
        const displayValue = typeof value === 'object' ? JSON.stringify(value) : String(value);
        rows += `
          <div class="info-row">
            <span class="label">${label}:</span>
            <span class="value">${escapeHtml(displayValue)}</span>
          </div>
        `;
      }
      return rows;
    }

    function renderJwt(vpToken) {
      if (!vpToken) return '<span class="json-bracket">null</span>';
      const parts = vpToken.split('.');
      if (parts.length !== 3) return escapeHtml(vpToken);

      return `
        <span class="jwt-part header">${escapeHtml(parts[0])}</span>
        <span class="jwt-part payload">${escapeHtml(parts[1])}</span>
        <span class="jwt-part sig">${escapeHtml(parts[2])}</span>
      `;
    }

    function renderJwtDecoded(vpToken) {
      if (!vpToken) return '<span class="json-bracket">null</span>';
      const parts = vpToken.split('.');
      if (parts.length !== 3) return escapeHtml(vpToken);

      try {
        const header = JSON.parse(atob(parts[0]));
        const payload = JSON.parse(atob(parts[1]));
        return `
          <div style="margin-bottom: 15px;"><span class="jwt-part header">/* JOSE Header */</span>${syntaxHighlight(header)}</div>
          <div><span class="jwt-part payload">/* Payload */</span>${syntaxHighlight(payload)}</div>
        `;
      } catch {
        return escapeHtml(vpToken);
      }
    }

    function syntaxHighlight(obj) {
      const json = JSON.stringify(obj, null, 2);
      return json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"([^"]+)":/g, '<span class="json-key">"$1"</span>:')
        .replace(/: "([^"]+)"/g, ': <span class="json-string">"$1"</span>')
        .replace(/: (\d+\.?\d*)/g, ': <span class="json-number">$1</span>')
        .replace(/: (true|false)/g, ': <span class="json-bool">$1</span>')
        .replace(/: (null)/g, ': <span class="json-bracket">$1</span>')
        .replace(/([{}[\]])/g, '<span class="json-bracket">$1</span>');
    }

    function switchTab(tab) {
      currentTab = tab;
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      document.querySelector(`.tab[onclick*="${tab}"]`).classList.add('active');
      document.getElementById(`tab-${tab}`).classList.add('active');
    }

    function copyContent(btn, elementId) {
      const el = document.getElementById(elementId);
      const text = el.textContent || el.innerText;
      navigator.clipboard.writeText(text.trim()).then(() => {
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 2000);
      });
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function goToDashboard() {
      window.location.href = '/dashboard?session=' + sessionToken;
    }

    function logout() {
      window.location.href = '/login';
    }

    function showError(message) {
      document.getElementById('content').innerHTML = `<div class="error">${message}</div>`;
    }
  </script>
</body>
</html>
