<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SSI Login - Identity Lab</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg-primary: #080808;
      --bg-secondary: #0f0f0f;
      --text-primary: #e8e8e2;
      --text-secondary: #a8a8a0;
      --accent: #00ff88;
      --accent-dim: #00cc6e;
      --border: #1a1a1a;
      --error: #ff4444;
      --success: #00ff88;
    }

    body {
      background-color: var(--bg-primary);
      color: var(--text-primary);
      font-family: 'JetBrains Mono', monospace;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-container {
      max-width: 600px;
      width: 100%;
    }

    .header {
      text-align: center;
      margin-bottom: 40px;
    }

    .header h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 32px;
      font-weight: 600;
      margin-bottom: 8px;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .header p {
      color: var(--text-secondary);
      font-size: 14px;
      letter-spacing: 1px;
    }

    .divider {
      height: 1px;
      background: var(--border);
      margin: 30px 0;
      position: relative;
    }

    .divider::after {
      content: 'OR';
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      background: var(--bg-primary);
      padding: 0 10px;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .login-methods {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 40px;
      margin-bottom: 30px;
    }

    .method {
      padding: 40px;
      border: 1px solid var(--border);
      background: var(--bg-secondary);
      transition: all 0.3s ease;
      width: 100%;
      max-width: 400px;
      text-align: center;
    }

    .method:hover {
      border-color: var(--accent);
      background: rgba(0, 255, 136, 0.02);
    }

    .method-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 25px;
      color: var(--text-secondary);
    }

    .method-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      justify-content: center;
    }

    .qr-code {
      width: 280px;
      height: 280px;
      background: white;
      padding: 12px;
      border: 2px solid var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .qr-code img {
      width: 100%;
      height: 100%;
      image-rendering: pixelated;
    }

    .qr-status {
      font-size: 11px;
      color: var(--text-secondary);
      text-align: center;
    }

    .button {
      padding: 12px 24px;
      border: 1px solid var(--accent);
      background: transparent;
      color: var(--accent);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .button:hover {
      background: var(--accent);
      color: var(--bg-primary);
    }

    .button:active {
      transform: scale(0.98);
    }

    .button.loading {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .status-message {
      padding: 15px;
      border: 1px solid var(--border);
      background: var(--bg-secondary);
      font-size: 12px;
      margin-top: 20px;
      display: none;
      animation: slideIn 0.3s ease;
    }

    .status-message.show {
      display: block;
    }

    .status-message.success {
      border-color: var(--success);
      color: var(--success);
    }

    .status-message.error {
      border-color: var(--error);
      color: var(--error);
    }

    .status-message.info {
      border-color: var(--accent);
      color: var(--accent);
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .loading-spinner {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
      margin-right: 8px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .footer {
      text-align: center;
      font-size: 11px;
      color: var(--text-secondary);
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    @media (max-width: 600px) {
      .method {
        max-width: 100%;
      }

      .qr-code {
        width: 220px;
        height: 220px;
      }

      .header h1 {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="header">
      <h1>🔐 SSI Login</h1>
      <p>PRESENT YOUR ACADEMIC CREDENTIAL</p>
    </div>

    <div class="login-methods">
      <!-- Combined Login Method -->
      <div class="method">
        <div class="method-title">📱 Scan QR Code</div>
        <div class="method-content">
          <div class="qr-code" id="qrCodeContainer">
            <img id="qrImage" src="" alt="QR Code" style="display: none;">
            <div style="text-align: center; color: var(--text-secondary); font-size: 12px;">
              Loading QR...
            </div>
          </div>
          <div class="qr-status">Scan with your SIOP v2 wallet app</div>
        </div>
      </div>

      <!-- Alternative Same Device -->
      <div class="method" style="max-width: 400px; width: 100%;">
        <div class="method-title">🔑 Or Launch Wallet Directly</div>
        <div class="method-content">
          <button class="button" id="ssiLoginBtn" onclick="handleSameDeviceLogin()">
            Launch SSI Wallet
          </button>
          <div class="qr-status" id="sameDeviceStatus">For same-device authentication</div>
        </div>
      </div>
    </div>

    <div class="status-message" id="statusMessage"></div>

    <div class="footer">
      <p>Identity Lab Demo — SIOP v2 Authentication</p>
      <p style="margin-top: 8px; font-size: 10px;">Issuer: did:web:identitylab.id</p>
    </div>
  </div>

  <script>
    const state = {
      sessionId: null,
      requestJwt: null,
    };

    // Initialize login on page load
    document.addEventListener('DOMContentLoaded', async () => {
      await initializeLogin();
    });

    async function initializeLogin() {
      try {
        showStatus('Generating SIOP request...', 'info');
        
        const response = await fetch('/api/auth/siop-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });

        if (!response.ok) {
          throw new Error('Failed to generate SIOP request');
        }

        const data = await response.json();
        state.sessionId = data.sessionId;
        state.requestJwt = data.requestJwt;

        // Generate QR code with SIOP request
        await generateQRCode(data.requestJwt);
        
        clearStatus();
      } catch (error) {
        showStatus(`Error: ${error.message}`, 'error');
      }
    }

    async function generateQRCode(requestJwt) {
      try {
        // SIOP v2 standard: QR should contain a URI with the request JWT
        const siopUri = `siopv2://?request=${encodeURIComponent(requestJwt)}`;
        
        // Encode the URI in QR code
        const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=${encodeURIComponent(siopUri)}`;
        const qrImg = document.getElementById('qrImage');
        qrImg.src = qrUrl;
        qrImg.style.display = 'block';
      } catch (error) {
        console.error('QR generation error:', error);
        showStatus('Failed to generate QR code', 'error');
      }
    }

    function handleSameDeviceLogin() {
      if (!state.requestJwt) {
        showStatus('SIOP request not ready', 'error');
        return;
      }

      // Custom URI scheme for wallet apps
      const deepLink = `siopv2://?request=${encodeURIComponent(state.requestJwt)}`;
      
      showStatus(`<span class="loading-spinner"></span> Opening wallet...`, 'info');
      
      // Try to open the deep link
      window.location.href = deepLink;

      // Fallback: Show instructions if no wallet is installed
      setTimeout(() => {
        showStatus('Install a SIOP v2 compatible wallet to use this feature', 'error');
      }, 1500);
    }

    function showStatus(message, type) {
      const statusEl = document.getElementById('statusMessage');
      statusEl.innerHTML = message;
      statusEl.className = `status-message show ${type}`;
    }

    function clearStatus() {
      const statusEl = document.getElementById('statusMessage');
      statusEl.className = 'status-message';
    }

    // Poll for successful authentication (if callback is same device)
    setInterval(() => {
      if (state.sessionId) {
        fetch(`/api/auth/verify?token=${state.sessionId}`)
          .then(r => r.json())
          .then(data => {
            if (data.authenticated) {
              showStatus(`✓ Welcome ${data.user.name || data.user.did}!`, 'success');
              setTimeout(() => {
                window.location.href = '/dashboard?session=' + state.sessionId;
              }, 1500);
            }
          })
          .catch(() => {}); // Silent - polling only
      }
    }, 2000);
  </script>
</body>
</html>
