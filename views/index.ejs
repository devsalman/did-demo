<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SSI VC Issuer — Create Verifiable Credentials</title>
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <header>
    <div class="header-left">
      <div class="shield-icon">🛡️</div>
      SSI / VC ISSUER
    </div>
    <div class="header-right">Demo</div>
  </header>

  <div class="container">
    <!-- Left Column — Form -->
    <div class="form-section">
      <h1>Issue a Verifiable<br /><span class="accent">Credential</span></h1>
      <p>Create and sign a W3C-compliant verifiable credential with custom claims.</p>

      <!-- Subject DID -->
      <div class="form-group">
        <label class="form-label">Subject DID <span class="form-label-note">(leave blank to
            auto-generate)</span></label>
        <input type="text" id="subjectDid" placeholder="did:key:z…" />
      </div>

      <!-- Claims -->
      <div class="form-group">
        <div class="claims-header">
          <label class="form-label">Claims</label>
          <span class="claims-count"><span id="claimsCount">1</span> field</span>
        </div>

        <div id="claimsContainer"></div>

        <button class="add-claim-btn" onclick="addClaim()">
          <span>+</span> Add field
        </button>
      </div>

      <!-- Create VC Button -->
      <button class="create-btn" onclick="createVC()" id="createBtn">
        CREATE VC
      </button>
    </div>

    <!-- Right Column — Output Panel -->
    <div class="output-section">
      <div class="output-header">
        <span class="output-label">Output</span>
        <div class="output-actions" id="outputActions" style="display: none;">
          <button class="output-action" onclick="showCredentialView()">
            <span>📄</span> JSON
          </button>
          <button class="output-action" onclick="showJWTEncodedView()">
            <span>🔐</span> JWT
          </button>
          <button class="output-action" onclick="showJWTDecodedView()">
            <span>🔓</span> Decoded
          </button>
          <button class="output-action" onclick="showQRView()">
            <span>📱</span> QR
          </button>
          <button class="output-action" onclick="copyCurrentOutput()">
            <span id="copyIcon">📋</span> Copy
          </button>
          <button class="output-action" onclick="resetOutput()">
            Reset
          </button>
        </div>
      </div>

      <div class="output-panel" id="outputPanel">
        <div class="state-idle">
          <div class="idle-icon">🛡️</div>
          <div class="idle-text">Fill in claims and press Create VC</div>
        </div>
      </div>

      <div class="output-note">
        Output conforms to W3C VC Data Model 2.0. Using W3C VC JOSE proof mechanism.
      </div>
    </div>
  </div>

  <script>
    const state = {
      claims: [{ key: '', value: '' }],
      currentVC: null,
      currentJWT: null,
      currentView: 'json',
      isCreating: false,
    };

    function updateClaimsCount() {
      document.getElementById('claimsCount').textContent = state.claims.length;
    }

    function renderClaims() {
      const container = document.getElementById('claimsContainer');
      container.innerHTML = state.claims.map((claim, idx) => `
          <div class="claim-row" id="claim-${idx}">
            <div class="claim-key">
              <input type="text" id="claim-key-${idx}" placeholder="e.g., name" value="${claim.key}" onchange="updateClaim(${idx}, 'key', this.value)" />
            </div>
            <div class="claim-separator">→</div>
            <div class="claim-value">
              <input type="text" id="claim-value-${idx}" placeholder="e.g., John Doe" value="${claim.value}" onchange="updateClaim(${idx}, 'value', this.value)" />
            </div>
            <button class="claim-delete" onclick="deleteClaim(${idx})" ${state.claims.length === 1 ? 'disabled' : ''}>
              🗑️
            </button>
            ${claim.key && isDuplicateKey(claim.key, idx) ? '<div class="claim-error"><span>⚠️</span> Duplicate key</div>' : ''}
            ${!claim.key && claim.value ? '<div class="claim-error"><span>⚠️</span> Key required</div>' : ''}
          </div>
        `).join('');
      updateClaimsCount();
    }

    function updateClaim(idx, field, value) {
      console.log(`Updating claim ${idx} field ${field} to value:`, value);
      state.claims[idx][field] = value;
      renderClaims();
    }

    function deleteClaim(idx) {
      if (state.claims.length > 1) {
        state.claims.splice(idx, 1);
        renderClaims();
      }
    }

    function addClaim() {
      state.claims.push({ key: '', value: '' });
      renderClaims();
    }

    function isDuplicateKey(key, excludeIdx) {
      return state.claims.filter((c, i) => c.key === key && i !== excludeIdx && c.key !== '').length > 0;
    }

    function getValidClaims() {
      console.log('Getting valid claims from state:', state.claims)
      return state.claims
    }

    async function createVC() {
      const validClaims = getValidClaims();
      if (validClaims.length === 0) {
        alert('Please fill at least one claim (key and value)');
        return;
      }

      const subjectDid = document.getElementById('subjectDid').value;
      const claims = Object.fromEntries(validClaims.map(c => [c.key, c.value]));

      state.isCreating = true;
      const btn = document.getElementById('createBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="btn-spinner"></span>Signing credential…';

      showCreatingState();

      try {
        console.log('Creating VC with subjectDid:', subjectDid, 'claims:', claims);
        await new Promise(r => setTimeout(r, 2000));

        const response = await fetch('/api/vc/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subjectDid, claims }),
        });

        const result = await response.json();

        if (response.ok) {
          state.currentVC = result.data.credential;
          state.currentJWT = result.data.jwt;
          state.currentView = 'json';
          showSuccessState(state.currentVC);
        } else {
          showErrorState(result.error);
        }
      } catch (error) {
        showErrorState(error.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = 'CREATE VC';
        state.isCreating = false;
      }
    }

    function showCreatingState() {
      const panel = document.getElementById('outputPanel');
      panel.className = 'output-panel';
      panel.innerHTML = `
          <div class="state-idle" style="gap: 24px;">
            <div class="signing-grid">
              ${Array(32).fill().map(() => '<div class="signing-cell"></div>').join('')}
            </div>
            <div class="signing-text">SIGNING…</div>
          </div>
        `;
      document.getElementById('outputActions').style.display = 'none';
    }

    function showSuccessState(vc) {
      const panel = document.getElementById('outputPanel');
      const jsonStr = JSON.stringify(vc, null, 2);
      const highlighted = jsonStr
        .replace(/"([^"]+)"(\s*:)/g, '<span class="json-key">"$1"</span>$2')
        .replace(/: "([^"]*)"/g, ': <span class="json-string">"$1"</span>')
        .replace(/: (\d+|true|false|null)/g, ': <span class="json-string">$1</span>')
        .replace(/"proofValue"[^}]*"[^"]*"/, (match) => `<span class="json-proof">${match}</span>`)
        .replace(/[{}[\]]/g, (match) => `<span class="json-bracket">${match}</span>`)
        .replace(
          /"([A-Za-z0-9-_]+)\.([A-Za-z0-9-_]+)\.([A-Za-z0-9-_]+)"/g,
          (_, header, payload, signature) =>
            `"${[
              `<span class="jwt-header">${header}</span>`,
              `<span class="jwt-dot">.</span>`,
              `<span class="jwt-payload">${payload}</span>`,
              `<span class="jwt-dot">.</span>`,
              `<span class="jwt-signature">${signature}</span>`
            ].join('')}"`
        )

      panel.className = 'output-panel';
      panel.innerHTML = `
          <div class="output-json">${highlighted}</div>
          <div class="output-footer">
            <div class="status-dot"></div>
            <div class="status-text">CREDENTIAL SIGNED</div>
          </div>
        `;
      document.getElementById('outputActions').style.display = 'flex';
    }

    function showQR() {
      const panel = document.getElementById('outputPanel');
      if (!state.currentJWT) {
        panel.innerHTML = `<div class="state-error"><div class="error-message">No JWT available</div></div>`;
        return;
      }
      panel.className = 'output-panel qr';
      panel.innerHTML = `
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(state.currentJWT)}" alt="QR Code" style="max-width: 100%; border-radius: 4px;" />
      `;
      document.getElementById('outputActions').style.display = 'flex';
    }

    function showQRView() {
      state.currentView = 'qr';
      showQR();
    }

    function showErrorState(error) {
      const panel = document.getElementById('outputPanel');
      panel.className = 'output-panel';
      panel.innerHTML = `
        <div class="state-error">
          <div class="error-icon">⚠️</div>
          <div class="error-message">${error}</div>
          <button class="error-retry" onclick="createVC()">Try again</button>
        </div>
      `;
      document.getElementById('outputActions').style.display = 'none';
    }

    function copyCurrentOutput() {
      let textToCopy = '';
      
      if (state.currentView === 'json' && state.currentVC) {
        textToCopy = JSON.stringify(state.currentVC, null, 2);
      } else if (state.currentView === 'jwt-encoded' && state.currentJWT) {
        textToCopy = state.currentJWT;
      } else if (state.currentView === 'jwt-decoded' && state.currentJWT) {
        const jwtParts = state.currentJWT.split('.');
        const header = JSON.parse(atob(jwtParts[0]));
        const payload = JSON.parse(atob(jwtParts[1]));
        const displayObj = { header, payload, signature: jwtParts[2].substring(0, 32) + '...' };
        textToCopy = JSON.stringify(displayObj, null, 2);
      } else {
        return;
      }

      navigator.clipboard.writeText(textToCopy).then(() => {
        const btn = event.target.closest('.output-action');
        const icon = btn.querySelector('span:first-child');
        btn.innerHTML = '<span>✓</span> Copied';
        setTimeout(() => {
          btn.innerHTML = '<span id="copyIcon">📋</span> Copy';
        }, 2000);
      }).catch(err => console.error('Copy failed:', err));
    }

    function showCredentialView() {
      if (state.currentVC) {
        state.currentView = 'json';
        showSuccessState(state.currentVC);
      }
    }

    function showJWTEncodedView() {
      if (state.currentJWT) {
        state.currentView = 'jwt-encoded';
        const panel = document.getElementById('outputPanel');
        
        // Split JWT into parts for highlighting
        const jwtParts = state.currentJWT.split('.');
        const highlightedJWT = `${jwtParts[0]}.<wbr><span style="color: var(--accent);">${jwtParts[1]}</span>.<wbr>${jwtParts[2]}`;
        
        panel.className = 'output-panel';
        panel.innerHTML = `
          <div class="output-json" style="word-break: break-all;">${highlightedJWT}</div>
          <div class="output-footer">
            <div class="status-dot"></div>
            <div class="status-text">JWT ENCODED</div>
            <div class="proof-type">BASE64URL</div>
          </div>
        `;
        document.getElementById('outputActions').style.display = 'flex';
      }
    }

    function showJWTDecodedView() {
      if (state.currentJWT) {
        state.currentView = 'jwt-decoded';
        const panel = document.getElementById('outputPanel');
        const jwtParts = state.currentJWT.split('.');
        
        try {
          const header = JSON.parse(atob(jwtParts[0]));
          const payload = JSON.parse(atob(jwtParts[1]));
          
          const displayObj = {
            header,
            payload,
            signature: jwtParts[2].substring(0, 32) + '...'
          };
          
          const jsonStr = JSON.stringify(displayObj, null, 2);
          const highlighted = jsonStr
            .replace(/"([^"]+)"(\s*:)/g, '<span class="json-key">"$1"</span>$2')
            .replace(/: "([^"]*)"/g, ': <span class="json-string">"$1"</span>')
            .replace(/: ({[^}]*})/g, (match) => `: <span class="json-string">${match.substring(2)}</span>`)
            .replace(/: \[/g, ': <span class="json-bracket">[</span>')
            .replace(/\]/g, '<span class="json-bracket">]</span>')
            .replace(/[{}]/g, (match) => `<span class="json-bracket">${match}</span>`);

          panel.className = 'output-panel';
          panel.innerHTML = `
            <div class="output-json">${highlighted}</div>
            <div class="output-footer">
              <div class="status-dot"></div>
              <div class="status-text">JWT DECODED</div>
              <div class="proof-type">JOSE</div>
            </div>
          `;
        } catch (error) {
          panel.innerHTML = `
            <div class="state-error">
              <div class="error-icon">⚠️</div>
              <div class="error-message">Failed to decode JWT: ${error.message}</div>
            </div>
          `;
        }
        document.getElementById('outputActions').style.display = 'flex';
      }
    }

    function resetOutput() {
      const panel = document.getElementById('outputPanel');
      panel.className = 'output-panel';
      panel.innerHTML = `
          <div class="state-idle">
            <div class="idle-icon">🛡️</div>
            <div class="idle-text">Fill in claims and press Create VC</div>
          </div>
        `;
      document.getElementById('outputActions').style.display = 'none';
      state.currentVC = null;
    }

    renderClaims();
  </script>
</body>

</html>