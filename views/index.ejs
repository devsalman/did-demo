<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SSI VC Issuer — Create Verifiable Credentials</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --bg-primary: #080808;
        --bg-card: #111110;
        --text-primary: #e8e8e2;
        --text-muted: rgba(232, 232, 226, 0.4);
        --accent: #00ff88;
        --accent-hover: #00ff88cc;
        --border: rgba(232, 232, 226, 0.12);
        --input-bg: #1a1a18;
        --error: #ff4444;
      }

      body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: 'JetBrains Mono', monospace;
        line-height: 1.6;
        overflow-x: hidden;
      }

      /* Header */
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
        border-bottom: 1px solid var(--border);
        max-width: 2048px;
        margin: 0 auto;
        width: 100%;
      }

      .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .shield-icon {
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .header-right {
        font-size: 10px;
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 1px;
      }

      /* Main Container */
      .container {
        max-width: 1024px;
        margin: 0 auto;
        padding: 48px 40px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
      }

      /* Left Column — Form */
      .form-section h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
        line-height: 1.3;
      }

      .form-section h1 .accent {
        color: var(--accent);
      }

      .form-section > p {
        font-size: 12px;
        color: var(--text-muted);
        margin-bottom: 32px;
        line-height: 1.5;
      }

      .form-group {
        margin-bottom: 24px;
      }

      .form-label {
        display: block;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
        margin-bottom: 8px;
      }

      .form-label-note {
        font-size: 9px;
        color: var(--text-muted);
        display: inline;
      }

      input {
        width: 100%;
        background-color: var(--input-bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 12px 14px;
        color: var(--text-primary);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        transition: border-color 0.2s ease;
      }

      input:focus {
        outline: none;
        border-color: var(--accent);
      }

      input::placeholder {
        color: var(--text-muted);
      }

      /* Claims Section */
      .claims-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
      }

      .claims-count {
        font-size: 9px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .claim-row {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        margin-bottom: 12px;
        position: relative;
      }

      .claim-key {
        width: 144px;
        flex-shrink: 0;
      }

      .claim-key input {
        width: 100%;
      }

      .claim-separator {
        color: var(--text-muted);
        padding-top: 12px;
        flex-shrink: 0;
        font-size: 10px;
      }

      .claim-value {
        flex: 1;
      }

      .claim-value input {
        width: 100%;
      }

      .claim-delete {
        flex-shrink: 0;
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 12px 4px;
        font-size: 14px;
        transition: color 0.2s ease;
      }

      .claim-delete:hover:not(:disabled) {
        color: var(--error);
      }

      .claim-delete:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }

      .claim-error {
        font-size: 9px;
        color: var(--error);
        margin-top: 4px;
        display: flex;
        gap: 4px;
        align-items: center;
      }

      .add-claim-btn {
        width: 100%;
        background: none;
        border: 1px dashed var(--text-muted);
        color: var(--text-muted);
        padding: 12px;
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: border-color 0.2s ease;
        margin-top: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }

      .add-claim-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      /* Create VC Button */
      .create-btn {
        width: 100%;
        background-color: var(--accent);
        color: var(--bg-primary);
        padding: 14px;
        border: none;
        border-radius: 4px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        cursor: pointer;
        margin-top: 32px;
        transition: all 0.2s ease;
      }

      .create-btn:hover:not(:disabled) {
        background-color: var(--accent-hover);
      }

      .create-btn:active:not(:disabled) {
        transform: scale(0.98);
      }

      .create-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .btn-spinner {
        display: inline-block;
        width: 12px;
        height: 12px;
        border: 2px solid rgba(8, 8, 8, 0.3);
        border-top-color: var(--bg-primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-right: 6px;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      /* Right Column — Output Panel */
      .output-section {
        display: flex;
        flex-direction: column;
      }

      .output-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
      }

      .output-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
      }

      .output-actions {
        display: flex;
        gap: 16px;
      }

      .output-action {
        background: none;
        border: none;
        color: var(--text-muted);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: color 0.2s ease;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .output-action:hover {
        color: var(--accent);
      }

      .output-panel {
        background-color: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 4px;
        min-height: 520px;
        padding: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        position: relative;
        overflow: hidden;
      }

      /* Idle State */
      .state-idle {
        flex-direction: column;
        gap: 16px;
        text-align: center;
      }

      .idle-icon {
        width: 60px;
        height: 60px;
        border: 1px solid var(--border);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 28px;
      }

      .idle-text {
        font-size: 11px;
        color: var(--text-muted);
      }

      /* Creating State */
      .signing-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 6px;
        margin-bottom: 24px;
      }

      .signing-cell {
        width: 16px;
        height: 16px;
        background-color: var(--accent);
        border-radius: 2px;
        animation: pulse-cell 1.4s ease-in-out infinite;
      }

      @keyframes pulse-cell {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 1; }
      }

      .signing-text {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
        animation: pulse 1.4s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 0.5; }
        50% { opacity: 1; }
      }

      /* Success State */
      .output-json {
        width: 100%;
        height: 100%;
        overflow-y: auto;
        font-size: 11px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
      }

      /* Syntax highlighting */
      .json-key {
        color: var(--text-muted);
      }

      .json-string {
        color: var(--text-primary);
      }

      .json-proof {
        color: var(--accent);
        font-weight: 600;
      }

      .json-bracket {
        color: rgba(232, 232, 226, 0.15);
      }

      .output-footer {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, var(--bg-card), transparent);
        padding: 20px 32px 32px;
        border-top: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 10px;
        color: var(--accent);
      }

      .status-dot {
        width: 8px;
        height: 8px;
        background-color: var(--accent);
        border-radius: 50%;
        animation: pulse 1.4s ease-in-out infinite;
      }

      .status-text {
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
      }

      .proof-type {
        margin-left: auto;
        color: var(--text-muted);
        font-size: 9px;
      }

      .output-note {
        margin-top: 12px;
        font-size: 9px;
        color: var(--text-muted);
        line-height: 1.5;
      }

      /* Error State */
      .state-error {
        flex-direction: column;
        gap: 12px;
        text-align: center;
      }

      .error-icon {
        font-size: 24px;
        color: var(--error);
      }

      .error-message {
        font-size: 11px;
        color: var(--text-primary);
      }

      .error-retry {
        background: none;
        border: none;
        color: var(--accent);
        font-size: 10px;
        text-decoration: underline;
        cursor: pointer;
        transition: color 0.2s ease;
      }

      .error-retry:hover {
        color: var(--accent-hover);
      }

      /* Responsive */
      @media (max-width: 768px) {
        header {
          padding: 20px 24px;
        }

        .container {
          grid-template-columns: 1fr;
          gap: 32px;
          padding: 32px 24px;
        }

        .form-section h1 {
          font-size: 22px;
        }

        .output-panel {
          min-height: 400px;
        }
      }

      /* Scrollbar */
      .output-json::-webkit-scrollbar {
        width: 6px;
      }

      .output-json::-webkit-scrollbar-track {
        background: transparent;
      }

      .output-json::-webkit-scrollbar-thumb {
        background: var(--accent);
        border-radius: 3px;
      }

      .output-json::-webkit-scrollbar-thumb:hover {
        background: var(--accent-hover);
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-left">
        <div class="shield-icon">🛡️</div>
        SSI / VC ISSUER
      </div>
      <div class="header-right">Demo</div>
    </header>

    <div class="container">
      <!-- Left Column — Form -->
      <div class="form-section">
        <h1>Issue a Verifiable<br /><span class="accent">Credential</span></h1>
        <p>Create and sign a W3C-compliant verifiable credential with custom claims.</p>

        <!-- Subject DID -->
        <div class="form-group">
          <label class="form-label">Subject DID <span class="form-label-note">(leave blank to auto-generate)</span></label>
          <input type="text" id="subjectDid" placeholder="did:key:z…" />
        </div>

        <!-- Claims -->
        <div class="form-group">
          <div class="claims-header">
            <label class="form-label">Claims</label>
            <span class="claims-count"><span id="claimsCount">1</span> field</span>
          </div>

          <div id="claimsContainer"></div>

          <button class="add-claim-btn" onclick="addClaim()">
            <span>+</span> Add field
          </button>
        </div>

        <!-- Create VC Button -->
        <button class="create-btn" onclick="createVC()" id="createBtn">
          CREATE VC
        </button>
      </div>

      <!-- Right Column — Output Panel -->
      <div class="output-section">
        <div class="output-header">
          <span class="output-label">Output</span>
          <div class="output-actions" id="outputActions" style="display: none;">
            <button class="output-action" onclick="copyJSON()">
              <span id="copyIcon">📋</span> Copy JSON
            </button>
            <button class="output-action" onclick="resetOutput()">
              Reset
            </button>
          </div>
        </div>

        <div class="output-panel" id="outputPanel">
          <div class="state-idle">
            <div class="idle-icon">🛡️</div>
            <div class="idle-text">Fill in claims and press Create VC</div>
          </div>
        </div>

        <div class="output-note">
          Output conforms to W3C VC Data Model 1.1. Proof value is simulated — wire a real Ed25519 signer for production.
        </div>
      </div>
    </div>

    <script>
      const state = {
        claims: [{ key: '', value: '' }],
        currentVC: null,
        isCreating: false,
      };

      function updateClaimsCount() {
        document.getElementById('claimsCount').textContent = state.claims.length;
      }

      function renderClaims() {
        const container = document.getElementById('claimsContainer');
        container.innerHTML = state.claims.map((claim, idx) => `
          <div class="claim-row" id="claim-${idx}">
            <div class="claim-key">
              <input type="text" placeholder="e.g., name" value="${claim.key}" onchange="updateClaim(${idx}, 'key', this.value)" />
            </div>
            <div class="claim-separator">→</div>
            <div class="claim-value">
              <input type="text" placeholder="e.g., John Doe" value="${claim.value}" onchange="updateClaim(${idx}, 'value', this.value)" />
            </div>
            <button class="claim-delete" onclick="deleteClaim(${idx})" ${state.claims.length === 1 ? 'disabled' : ''}>
              🗑️
            </button>
            ${claim.key && isDuplicateKey(claim.key, idx) ? '<div class="claim-error"><span>⚠️</span> Duplicate key</div>' : ''}
            ${!claim.key && claim.value ? '<div class="claim-error"><span>⚠️</span> Key required</div>' : ''}
          </div>
        `).join('');
        updateClaimsCount();
      }

      function updateClaim(idx, field, value) {
        state.claims[idx][field] = value;
        renderClaims();
      }

      function deleteClaim(idx) {
        if (state.claims.length > 1) {
          state.claims.splice(idx, 1);
          renderClaims();
        }
      }

      function addClaim() {
        state.claims.push({ key: '', value: '' });
        renderClaims();
      }

      function isDuplicateKey(key, excludeIdx) {
        return state.claims.filter((c, i) => c.key === key && i !== excludeIdx && c.key !== '').length > 0;
      }

      function getValidClaims() {
        return state.claims.filter(c => c.key && c.value && !isDuplicateKey(c.key, -1));
      }

      async function createVC() {
        const validClaims = getValidClaims();
        if (validClaims.length === 0) {
          alert('Please fill at least one claim (key and value)');
          return;
        }

        const subjectDid = document.getElementById('subjectDid').value;
        const claims = Object.fromEntries(validClaims.map(c => [c.key, c.value]));

        state.isCreating = true;
        const btn = document.getElementById('createBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="btn-spinner"></span>Signing credential…';

        showCreatingState();

        try {
          await new Promise(r => setTimeout(r, 2000));

          const response = await fetch('/api/vc/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subjectDid, claims }),
          });

          const result = await response.json();

          if (response.ok) {
            state.currentVC = result.credential;
            showSuccessState(result.credential);
          } else {
            showErrorState(result.error);
          }
        } catch (error) {
          showErrorState(error.message);
        } finally {
          btn.disabled = false;
          btn.innerHTML = 'CREATE VC';
          state.isCreating = false;
        }
      }

      function showCreatingState() {
        const panel = document.getElementById('outputPanel');
        panel.className = 'output-panel';
        panel.innerHTML = `
          <div class="state-idle" style="gap: 24px;">
            <div class="signing-grid">
              ${Array(32).fill().map(() => '<div class="signing-cell"></div>').join('')}
            </div>
            <div class="signing-text">SIGNING…</div>
          </div>
        `;
        document.getElementById('outputActions').style.display = 'none';
      }

      function showSuccessState(vc) {
        const panel = document.getElementById('outputPanel');
        const jsonStr = JSON.stringify(vc, null, 2);
        const highlighted = jsonStr
          .replace(/"([^"]+)"(\s*:)/g, '<span class="json-key">"$1"</span>$2')
          .replace(/: "([^"]*)"/g, ': <span class="json-string">"$1"</span>')
          .replace(/: (\d+|true|false|null)/g, ': <span class="json-string">$1</span>')
          .replace(/"proofValue"[^}]*"[^"]*"/, (match) => `<span class="json-proof">${match}</span>`)
          .replace(/[{}[\]]/g, (match) => `<span class="json-bracket">${match}</span>`);

        panel.className = 'output-panel';
        panel.innerHTML = `
          <div class="output-json">${highlighted}</div>
          <div class="output-footer">
            <div class="status-dot"></div>
            <div class="status-text">CREDENTIAL SIGNED</div>
            <div class="proof-type">Ed25519Signature2020</div>
          </div>
        `;
        document.getElementById('outputActions').style.display = 'flex';
      }

      function showErrorState(error) {
        const panel = document.getElementById('outputPanel');
        panel.className = 'output-panel';
        panel.innerHTML = `
          <div class="state-error">
            <div class="error-icon">⚠️</div>
            <div class="error-message">${error}</div>
            <button class="error-retry" onclick="createVC()">Try again</button>
          </div>
        `;
        document.getElementById('outputActions').style.display = 'none';
      }

      function copyJSON() {
        const json = JSON.stringify(state.currentVC, null, 2);
        navigator.clipboard.writeText(json).then(() => {
          const btn = event.target.closest('.output-action');
          const icon = btn.querySelector('#copyIcon');
          const text = btn.textContent;
          btn.innerHTML = '<span>✓</span> Copied';
          setTimeout(() => {
            btn.innerHTML = '<span>📋</span> Copy JSON';
          }, 2000);
        });
      }

      function resetOutput() {
        const panel = document.getElementById('outputPanel');
        panel.className = 'output-panel';
        panel.innerHTML = `
          <div class="state-idle">
            <div class="idle-icon">🛡️</div>
            <div class="idle-text">Fill in claims and press Create VC</div>
          </div>
        `;
        document.getElementById('outputActions').style.display = 'none';
        state.currentVC = null;
      }

      renderClaims();
    </script>
  </body>
</html>
